# Conexão com o banco postgres do cardápio.
# Se a senha tiver caracteres especiais (@ : / etc.), use URL-encode (ex.: @ -> %40).
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/anacake_db

# Credenciais do administrador do painel /admin
ADMIN_USER=admin

# Hash bcrypt da senha do admin, codificado em base64 (evita conflito de '$' no .env).
# Gere com: node gen-cred.cjs "suaSenhaForte"
ADMIN_PASSWORD_HASH_B64=

# Segredo para assinar a sessão (use 32+ bytes aleatórios). Gere com gen-cred.cjs.
AUTH_SECRET=

# Defina como "true" apenas quando o site estiver atrás de HTTPS.
COOKIE_SECURE=false
