# Conexão com o banco postgres do cardápio (Neon / Supabase).
# ATENÇÃO: NUNCA use o prefixo NEXT_PUBLIC_ para segredos de banco de dados.
DATABASE_URL=postgresql://usuario:senha@host:5432/neondb?sslmode=require

# Credenciais do administrador do painel /admin
ADMIN_USER=admin

# Hash bcrypt da senha do admin, codificado em base64 (evita conflito de '$' no .env).
# Gere com: node gen-cred.cjs "suaSenhaForte"
ADMIN_PASSWORD_HASH_B64=

# Segredo para assinar a sessão JWT (mínimo 32 bytes). Gere com: node gen-cred.cjs
AUTH_SECRET=

# Defina como "true" em produção na Vercel (HTTPS ativo) e "false" em desenvolvimento local.
COOKIE_SECURE=false

# Rate Limiting distribuído (Upstash Redis) - Recomendado em produção na Vercel
# Crie uma database gratuita em https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
